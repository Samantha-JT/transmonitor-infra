{
  "title": "Cloudflare \u2014 trans-news.com",
  "uid": "cf-trans-news",
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests (24h)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "last_over_time(cf_requests_24h[2m])",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Unique Visitors (24h)",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "last_over_time(cf_unique_visitors_24h[2m])",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Threats Blocked (24h)",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "last_over_time(cf_threats_24h[2m])",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        }
      }
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "Cache Hit Ratio",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "last_over_time(cf_cache_hit_ratio[2m])",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "orange",
                "value": 30
              },
              {
                "color": "green",
                "value": 60
              }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "gauge",
      "title": "Threat Rate",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "last_over_time(cf_threat_rate[2m])",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 20,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Bandwidth (24h)",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "last_over_time(cf_bytes_24h[2m])",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Requests vs Threats (1h buckets)",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "expr": "last_over_time(cf_requests_total[2m])",
          "legendFormat": "Requests",
          "datasource": {
            "type": "prometheus"
          }
        },
        {
          "expr": "last_over_time(cf_threats_total[2m])",
          "legendFormat": "Threats",
          "datasource": {
            "type": "prometheus"
          }
        },
        {
          "expr": "last_over_time(cf_cached_requests[2m])",
          "legendFormat": "Cached",
          "datasource": {
            "type": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2
          }
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Bandwidth (1h buckets)",
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "last_over_time(cf_bytes_total[2m])",
          "legendFormat": "Total",
          "datasource": {
            "type": "prometheus"
          }
        },
        {
          "expr": "last_over_time(cf_cached_bytes[2m])",
          "legendFormat": "Cached",
          "datasource": {
            "type": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2
          }
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Cache Hit Ratio over time",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "last_over_time(cf_cache_hit_ratio[2m])",
          "legendFormat": "Cache hit %",
          "datasource": {
            "type": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2
          }
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Unique Visitors and Pageviews",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "last_over_time(cf_unique_visitors[2m])",
          "legendFormat": "Unique visitors",
          "datasource": {
            "type": "prometheus"
          }
        },
        {
          "expr": "last_over_time(cf_pageviews_total[2m])",
          "legendFormat": "Pageviews",
          "datasource": {
            "type": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2
          }
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Scrape Errors",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "expr": "cf_scrape_errors_total",
          "legendFormat": "Errors",
          "datasource": {
            "type": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Request rate delta vs 1h ago",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "last_over_time(cf_requests_total[2m]) - last_over_time(cf_requests_total[2m] offset 1h)",
          "legendFormat": "Delta vs 1h ago",
          "datasource": {
            "type": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": -100
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Threat rate over time",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "last_over_time(cf_threat_rate[2m])",
          "legendFormat": "Threat rate %",
          "datasource": {
            "type": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Bandwidth served from cache %",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "last_over_time(cf_cached_bytes[2m]) / last_over_time(cf_bytes_total[2m]) * 100",
          "legendFormat": "Cached bandwidth %",
          "datasource": {
            "type": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "orange",
                "value": 30
              },
              {
                "color": "green",
                "value": 60
              }
            ]
          }
        }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Bytes per request",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "cf_bytes_total / cf_requests_total",
          "legendFormat": "Bytes/request",
          "datasource": {
            "type": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2
          }
        }
      }
    },
    {
      "id": 16,
      "type": "stat",
      "title": "Scraper health",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "increase(cf_scrape_errors_total[5m])",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "noValue": "OK"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 0.001
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "OK",
                  "color": "green",
                  "index": 0
                }
              }
            },
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        }
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Rolling threat rate (1h window)",
      "gridPos": {
        "x": 4,
        "y": 40,
        "w": 10,
        "h": 4
      },
      "targets": [
        {
          "expr": "cf_threats_total / cf_requests_total * 100",
          "legendFormat": "Threat rate 1h %",
          "datasource": {
            "type": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Pageviews per visitor",
      "gridPos": {
        "x": 14,
        "y": 40,
        "w": 10,
        "h": 4
      },
      "targets": [
        {
          "expr": "cf_pageviews_total / cf_unique_visitors",
          "legendFormat": "Pages/visitor",
          "datasource": {
            "type": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "orange",
                "value": 1.5
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          }
        }
      }
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Requests: today vs yesterday",
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "cf_requests_24h",
          "legendFormat": "Today",
          "datasource": {
            "type": "prometheus"
          }
        },
        {
          "expr": "cf_requests_24h offset 24h",
          "legendFormat": "Yesterday",
          "datasource": {
            "type": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2
          }
        }
      }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Threats: today vs yesterday",
      "gridPos": {
        "x": 12,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "cf_threats_24h",
          "legendFormat": "Today",
          "datasource": {
            "type": "prometheus"
          }
        },
        {
          "expr": "cf_threats_24h offset 24h",
          "legendFormat": "Yesterday",
          "datasource": {
            "type": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        }
      }
    }
  ]
}