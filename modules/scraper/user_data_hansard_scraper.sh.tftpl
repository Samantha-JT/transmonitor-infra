#!/usr/bin/env bash
set -euo pipefail

AWS_REGION="eu-west-1"
SCRAPER_DIR="/home/ssm-user/hansard-scraper"
STATIC_BUCKET="${static_bucket_name}"
ARCHIVE_BUCKET="${archive_bucket_name}"
BOOTSTRAP_KEY="bootstrap/hansard-scraper.tar.gz"

dnf install -y python3 rsync gzip tar awscli || true

mkdir -p /home/ssm-user
chown ssm-user:ssm-user /home/ssm-user || true

# Restore scraper code/data if the instance has been rebuilt and the bootstrap archive exists.
if [ ! -f "$SCRAPER_DIR/scraper.py" ]; then
  mkdir -p "$SCRAPER_DIR"

  if aws s3api head-object \
      --bucket "$ARCHIVE_BUCKET" \
      --key "$BOOTSTRAP_KEY" \
      --region "$AWS_REGION" >/dev/null 2>&1; then

    aws s3 cp \
      "s3://$ARCHIVE_BUCKET/$BOOTSTRAP_KEY" \
      /tmp/hansard-scraper.tar.gz \
      --region "$AWS_REGION"

    tar -xzf /tmp/hansard-scraper.tar.gz -C /home/ssm-user
    rm -f /tmp/hansard-scraper.tar.gz
  fi
fi

mkdir -p "$SCRAPER_DIR"
chown -R ssm-user:ssm-user "$SCRAPER_DIR"

cat > "$SCRAPER_DIR/upload-db.sh" <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail

cd /home/ssm-user/hansard-scraper

test -s hansard_trans.db

aws s3 cp hansard_trans.db \
  s3://${static_bucket_name}/hansard_trans.db \
  --region eu-west-1 \
  --content-type application/vnd.sqlite3 \
  --cache-control "no-cache, no-store, must-revalidate"

gzip -9 -c hansard_trans.db > /tmp/hansard_trans.db.gz

aws s3 cp /tmp/hansard_trans.db.gz \
  s3://${static_bucket_name}/hansard_trans.db.gz \
  --region eu-west-1 \
  --content-type application/gzip \
  --content-encoding gzip \
  --cache-control "no-cache, no-store, must-revalidate"

rm -f /tmp/hansard_trans.db.gz
SCRIPT

cat > "$SCRAPER_DIR/run-update-and-upload.sh" <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail

cd /home/ssm-user/hansard-scraper

/usr/bin/python3 scraper.py update

./upload-db.sh
SCRIPT

chmod +x "$SCRAPER_DIR/upload-db.sh" "$SCRAPER_DIR/run-update-and-upload.sh"
chown ssm-user:ssm-user "$SCRAPER_DIR/upload-db.sh" "$SCRAPER_DIR/run-update-and-upload.sh"

cat > /etc/systemd/system/hansard-db-upload.service <<'EOF_SERVICE'
[Unit]
Description=Upload TransMonitor Hansard SQLite DB to S3
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ssm-user
WorkingDirectory=/home/ssm-user/hansard-scraper
ExecStart=/home/ssm-user/hansard-scraper/upload-db.sh
EOF_SERVICE

cat > /etc/systemd/system/hansard-db-upload.timer <<'EOF_TIMER'
[Unit]
Description=Upload TransMonitor Hansard SQLite DB to S3 daily

[Timer]
OnCalendar=*-*-* 04:00:00
Persistent=true
RandomizedDelaySec=900

[Install]
WantedBy=timers.target
EOF_TIMER

cat > /etc/systemd/system/hansard-scraper-update.service <<'EOF_SERVICE'
[Unit]
Description=Update TransMonitor Hansard database and upload to S3
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ssm-user
WorkingDirectory=/home/ssm-user/hansard-scraper
ExecStart=/home/ssm-user/hansard-scraper/run-update-and-upload.sh
EOF_SERVICE

cat > /etc/systemd/system/hansard-scraper-update.timer <<'EOF_TIMER'
[Unit]
Description=Run TransMonitor Hansard scraper update weekly

[Timer]
OnCalendar=Sun 02:00:00
Persistent=true
RandomizedDelaySec=900

[Install]
WantedBy=timers.target
EOF_TIMER

systemctl daemon-reload
systemctl enable hansard-db-upload.timer
systemctl enable hansard-scraper-update.timer
systemctl start hansard-db-upload.timer
systemctl start hansard-scraper-update.timer

# ── Chromium / Playwright runtime (for the article archiver) ───────────────────
# AL2023 is unsupported by `playwright install-deps` (assumes apt), so the
# Chromium system libraries are installed explicitly via dnf. Verified-working
# set from the running instance (ldd-confirmed).
dnf install -y \
  python3.11 python3.11-pip \
  nss atk at-spi2-atk cups-libs libdrm libxkbcommon \
  libXcomposite libXdamage libXext libXfixes libXrandr libXrender libXtst \
  libX11 libX11-xcb libxcb libXi libXau libxshmfence \
  mesa-libgbm mesa-dri-drivers alsa-lib pango cairo || true

# Playwright + boto3 + redis AS ssm-user → /home/ssm-user/.local and
# Chromium → /home/ssm-user/.cache/ms-playwright (the path the archiver expects).
sudo -u ssm-user /usr/bin/python3.11 -m pip install --user playwright boto3 redis || true
# Browser binary only — NOT --with-deps (install-deps broken on AL2023).
sudo -u ssm-user /usr/bin/python3.11 -m playwright install chromium || true

# ── Swap (Chromium full-page screenshots spike memory on a 1.8GB box) ──────────
if [ ! -f /swapfile ]; then
  fallocate -l 2G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

# ── Archiver code (fetched unconditionally so repo edits propagate on rebuild) ──
aws s3 cp "s3://$ARCHIVE_BUCKET/bootstrap/archiver.py" "$SCRAPER_DIR/archiver.py" --region "$AWS_REGION" || true
chown ssm-user:ssm-user "$SCRAPER_DIR/archiver.py"

# ── Archiver systemd service + timer (screenshot + text capture, every 3h) ─────
cat > /etc/systemd/system/transmonitor-archiver.service <<'EOF_SERVICE'
[Unit]
Description=TransMonitor article archiver — screenshot + text capture to S3
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ssm-user
WorkingDirectory=/home/ssm-user/hansard-scraper
ExecStart=/usr/bin/python3.11 archiver.py run
TimeoutStartSec=5400
EOF_SERVICE

cat > /etc/systemd/system/transmonitor-archiver.timer <<'EOF_TIMER'
[Unit]
Description=Run TransMonitor archiver every 3 hours

[Timer]
OnCalendar=*-*-* 00/3:15:00
Persistent=true
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
EOF_TIMER

systemctl daemon-reload
systemctl enable transmonitor-archiver.timer
systemctl start transmonitor-archiver.timer
